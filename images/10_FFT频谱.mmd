    end

    O1["128 柱"]
    R1["23.84 Hz / bin"]

    I1 --> I2 --> G1 --> G2 --> G3 --> G4 --> O1
    G2 -.-> R1

    class I1,I2,W1,B1,B2,B3,M1,M2,M3,S1,S2 n
    class O1,R1 k

    style G1 fill:#ffffff,stroke:#9a9a9a,color:#333333
    style G2 fill:#ffffff,stroke:#9a9a9a,color:#333333
