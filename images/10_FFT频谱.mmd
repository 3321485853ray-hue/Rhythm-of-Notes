        W1["Hann 窗"]
    end

    subgraph G2["FFT"]
        B1["位反转"]
        B2["1024 蝶形 × 11 级"]
        B3["旋转因子"]
        B1 --> B2
        B3 --> B2
    end

    subgraph G3["映射"]
        M1["幅度近似"]
        M2["2048 → 128 柱"]
        M3["柱高限幅"]
