%%{init: {"theme":"base","themeVariables":{"fontSize":"22px","fontFamily":"Microsoft YaHei, sans-serif","primaryColor":"#ffffff","primaryTextColor":"#111111","primaryBorderColor":"#555555","lineColor":"#666666"}}}%%
%% 图 2-4  声部分配与音高生成流程
flowchart LR
    classDef n fill:#ffffff,stroke:#5a5a5a,color:#111111,stroke-width:1.2px
    classDef k fill:#ececec,stroke:#333333,color:#000000,stroke-width:1.6px

    IN1["按键脉冲"]
    IN2["八度"]
    IN3["键位表"]

    subgraph G1["声部分配"]
        direction TB
        A1{"按下？"}
        A2["取空闲声部"]
        A3{"全忙？"}
        A4["抢占最早"]
        A5["绑定键 → 声部"]
        A6["松手释放"]
        A1 -->|是| A2 --> A3
        A3 -->|是| A4 --> A5
        A3 -->|否| A5
        A1 -->|否| A6
    end

    subgraph G2["音高"]
        direction TB
        M1["键位映射"]
        M2["键号 → 音名"]
        M3["八度叠加"]
        M4["相位步进表"]
        M1 --> M2 --> M3 --> M4
    end

    O1["门控 v_gate"]
    O2["触发 v_trig"]
    O3["绑定 v_keys"]
    O4["phase_step"]

    IN1 --> G1
    IN1 --> M1
    IN2 --> M3
    IN3 --> M1
    A5 --> O3
    A6 --> O3
    G1 --> O1
    G1 --> O2
    M4 --> O4

    class IN1,IN2,IN3 n
    class A1,A2,A3,A4,A5,A6,M1,M2,M3,M4 n
    class O1,O2,O3,O4 k

    style G1 fill:#ffffff,stroke:#9a9a9a,color:#333333
    style G2 fill:#ffffff,stroke:#9a9a9a,color:#333333
